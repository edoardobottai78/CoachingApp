{
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/proxy",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/mindfit",
      "destination": "/mindfit/index.html"
    },
    {
      "source": "/mindfit/(.*)",
      "destination": "/mindfit/index.html"
    }
  ]
}
